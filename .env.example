# Copy this file to .env.local. .env.local is gitignored.
#
# Receipt scanning goes through the app's own scan server (server/), which
# holds the Anthropic API key — the key is never in the app. Point this at the
# deployed Worker, or at `npm run dev` in server/ on your Mac's LAN address
# (e.g. http://192.168.1.9:8787) to test against a local copy.
#
# EXPO_PUBLIC_ vars are inlined into the app at build time; for EAS builds set
# this as an EAS environment variable too.
EXPO_PUBLIC_SCAN_URL=
