{
  "name": "bill-splitter-app",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "eas-build-pre-install": "chmod -R u+rwX ios 2>/dev/null || true; for f in ios/.xcode.env ios/.xcode.env.local; do [ -f \"$f\" ] && tr -d '\\r' < \"$f\" > \"$f.tmp\" && mv \"$f.tmp\" \"$f\"; done; true"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.11",
    "expo": "~57.0.27",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-calendars": "^1.1314.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "typescript": "~6.0.3"
  },
