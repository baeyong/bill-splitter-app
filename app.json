{
  "expo": {
    "name": "Split It",
    "slug": "split-it",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.baeyong.billsplitter",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.baeyong.billsplitter",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withSandboxingDisabled.js",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Split It uses the camera to photograph a receipt so it can read the items off it.",
          "photosPermission": "Split It needs access to your photos so you can pick a receipt you already took.",
          "microphonePermission": false
        }
      ],
      "expo-status-bar",
      "expo-splash-screen"
    ],
    "extra": {
      "eas": {
        "projectId": "ce89472d-3799-4d41-a2ad-2953613e006d"
      }
    },
    "owner": "baeyong1227"
  }
}
